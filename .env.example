testing comment
PORT=5000

# Signs and verifies the auth JWTs. The server refuses to start without it.
JWT_SECRET=change_me

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Transport Prisma uses to reach Postgres.
#   neon - Neon serverless driver over HTTPS/WebSocket (443)
#   tcp  - standard Postgres wire protocol (5432)
# Defaults to "neon" for *.neon.tech URLs, since many corporate and campus
# networks block outbound 5432 and only 443 gets through.
# DB_DRIVER=neon

# Comma-separated list of browser origins allowed to send credentialed
# requests. Required in production; any localhost origin is allowed in dev.
# CORS_ORIGIN=https://portal.example.com

# NODE_ENV=production
