# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
# Required: Secret used to sign and verify JWT authentication tokens.
JWT_SECRET=replace_with_a_long_secure_random_string

# Database Configuration
# Required: Connection string for PostgreSQL database (Neon or standard Postgres).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# DB Driver: "neon" for Neon Serverless WebSocket/HTTP (port 443), "tcp" for standard PostgreSQL (port 5432)
# Automatically defaults to "neon" for *.neon.tech hostnames.
# DB_DRIVER=neon

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins in production.
# In development, localhost origins are automatically permitted.
CORS_ORIGIN=https://caspian-connect-portal.vercel.app,http://localhost:8080,http://localhost:5173

# Frontend URL (used in email links and notifications)
FRONTEND_URL=https://caspian-connect-portal.vercel.app

# SMTP / Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
FROM_EMAIL="Caspian Connect <noreply@caspianconnect.com>"
ADMIN_EMAIL=admin@silkbridge.pk
