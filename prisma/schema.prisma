generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("AGENCY") // ADMIN or AGENCY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id          String   @id @default(uuid())
  title       String   // Maps to Package Name
  subtitle    String?
  region      String?
  duration    String?  // Maps to Duration (e.g. "4D/3N")
  difficulty  String?
  netPrice    Float    // Maps to FIT Price PP USD
  retailPrice Float    // Calculated FIT Retail price (Net * 1.66)
  active      Boolean  @default(true)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Excel columns (Single Occurrence)
  segment        String?  // Segment
  code           String?  // Package Code (e.g. "FAM-AZ-04")
  validity       String?  // Validity (e.g. "02 Jun–30 Sep 2026")
  hotelCategory  String?  // Hotel Category (e.g. "3*")
  groupNetPrice  Float?   // Group Price PP USD
  minPax         String?  // Min Pax (e.g. "FIT: 2 pax / Group: 15+ pax")
  route          String?  // Route
  shortProgram   String?  // Maps to Short Program (raw text description)
  includes       String?  // Includes
  excludes       String?  // Excludes
  eventIncluded  String?  // Event Included
  ticketIncluded String?  // Ticket Included
  notes          String?  // Notes
  sourceUrl      String?  // Source / URL
}

model Application {
  id           String   @id @default(uuid())
  userId       String?  @unique
  company      String
  license      String?
  email        String
  website      String?
  instagram    String?
  status       String   @default("pending")
  tierId       String   @default("silver")
  submitted    DateTime @default(now())
}

model Tier {
  id          String   @id // e.g. "silver", "gold"
  name        String
  discountPct Int
  color       String
}

model Booking {
  id           String   @id @default(uuid())
  packageTitle String
  clientName   String
  status       String   @default("pending") // confirmed, hold, cancelled
  amount       Float
  date         String   // Using String for simple YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
