generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("AGENCY") // ADMIN or AGENCY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  region      String?
  duration    Int?
  difficulty  String?
  netPrice    Float    // Our cost
  retailPrice Float    // Selling price for agencies
  active      Boolean  @default(true)
  image       String?
  itinerary   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id           String   @id @default(uuid())
  userId       String?  @unique
  company      String
  license      String?
  email        String
  website      String?
  instagram    String?
  status       String   @default("pending")
  tierId       String   @default("silver")
  submitted    DateTime @default(now())
}

model Tier {
  id          String   @id // e.g. "silver", "gold"
  name        String
  discountPct Int
  color       String
}

model Booking {
  id           String   @id @default(uuid())
  packageTitle String
  clientName   String
  status       String   @default("pending") // confirmed, hold, cancelled
  amount       Float
  date         String   // Using String for simple YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
